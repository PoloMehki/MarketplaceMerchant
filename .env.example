# .env.example — Task 0.1
# Template for required env vars. Copy to .env and fill in.
#
# Bedrock
# AWS_REGION=
# BEDROCK_MODEL_ID=
#
# Apify
# APIFY_TOKEN=
# APIFY_ECOMMERCE_ACTOR_ID=
# APIFY_FB_ACTOR_ID=
# MOCK_APIFY=false
#
# Box
# BOX_CLIENT_ID=
# BOX_CLIENT_SECRET=
# BOX_ROOT_FOLDER_ID=0
# BOX_JWT_CONFIG_PATH=box_config.json   # path to Box app JWT settings JSON (JWT auth)
# BOX_DEVELOPER_TOKEN=                  # short-lived dev token (alternative to JWT)
#
# Runtime
# MCP_CONFIG_PATH=config/mcp.json
# SQLITE_PATH=negagent.db
# HITL_ENABLED=true
# MATCH_CONFIDENCE_THRESHOLD=
# CONDITION_TOLERANCE=
